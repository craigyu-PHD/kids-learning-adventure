--- published-r6/src/styles/components/lesson.css
+++ feedback/src/styles/components/lesson.css
@@ -248,3 +248,157 @@
 /* Keep earned resources readable inside narrow reward cards. */
 .v4-quest-shell .v4-reward-values { flex-wrap:wrap; }
 .v4-quest-shell .v4-reward-values > span { white-space:nowrap; max-width:100%; }
+
+/* V6.5.3 feedback R2: natural-height teaching content owns its layout here.
+ * New timetable/card lanes avoid historical fixed-height dashboard rules. */
+.v4-quest-shell {
+  --lesson-ink:#203952;
+  --lesson-soft:#f2f7fc;
+  --lesson-surface:#fff;
+  --lesson-line:#cbddea;
+  --lesson-question:#edf5ff;
+  --lesson-question-line:#2773be;
+}
+.dark .v4-quest-shell {
+  --lesson-ink:#f3f6ff;
+  --lesson-soft:#29334e;
+  --lesson-surface:#222b43;
+  --lesson-line:#536581;
+  --lesson-question:#273e60;
+  --lesson-question-line:#72d6ff;
+}
+.v4-quest-shell .v653-preparation-stage { gap:16px; }
+.v653-preparation-stage .v4-lesson-preflight { display:grid; grid-template-columns:minmax(0,1fr); width:100%; margin:0; padding:18px; gap:16px; background:var(--lesson-soft); box-shadow:none; }
