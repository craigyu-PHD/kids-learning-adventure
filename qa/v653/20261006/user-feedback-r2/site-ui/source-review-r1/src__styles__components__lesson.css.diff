+.v653-teaching-timeline>details[open]>summary::after { content:'−'; }
+.v653-teaching-timeline>details>summary>b { padding:5px; border-radius:8px; font-size:14px; line-height:1.5; text-align:center; background:var(--lesson-soft); color:var(--lesson-accent,#075bc7); }
+.v653-teaching-timeline>details>summary>strong { color:var(--lesson-ink); font-size:16px; line-height:1.5; }
+.v653-teaching-timeline>details>div { padding:0 16px 14px; }
+.v653-teaching-timeline>details p { margin:0; color:var(--lesson-muted,#526780); font-size:14px; line-height:1.6; }
+.v653-teaching-timeline>details span { display:flex; gap:7px; align-items:start; margin-top:7px; font-size:13px; line-height:1.5; color:var(--lesson-ink); }
