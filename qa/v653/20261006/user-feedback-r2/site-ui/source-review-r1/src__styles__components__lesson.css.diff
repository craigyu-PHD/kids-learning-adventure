+.v653-preparation-heading p span { margin-inline:6px; }
+.v653-preparation-stage .v64-daily-participants { margin:0; }
+.v653-preparation-stage .v64-daily-participants>div { grid-template-columns:repeat(auto-fit,minmax(min(100%,120px),1fr)); grid-auto-flow:row; grid-auto-columns:auto; overflow:visible; }
+.v4-quest-shell .v653-preparation-summary { gap:12px; margin:0; grid-template-columns:repeat(2,minmax(0,1fr)); }
+.v4-quest-shell .v653-preparation-summary>article { padding:16px; background:var(--lesson-surface); border:1px solid var(--lesson-line); border-radius:16px; color:var(--lesson-ink); }
+.v4-quest-shell .v653-preparation-summary h3 { display:flex; align-items:center; gap:8px; margin:0 0 10px; font-size:17px; }
