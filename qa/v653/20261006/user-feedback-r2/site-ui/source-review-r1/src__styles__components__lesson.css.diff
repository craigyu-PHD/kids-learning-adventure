+.v4-quest-shell .v653-preparation-summary .v64-preparation-materials span { font-size:12px; line-height:1.5; color:var(--lesson-muted,#526780); }
+.v653-preparation-summary details { border-top:1px solid var(--lesson-line); }
+.v4-quest-shell .v653-preparation-summary summary { padding:10px 0; min-height:44px; font-size:14px; font-weight:750; }
+.v653-teaching-plan { min-width:0; }
