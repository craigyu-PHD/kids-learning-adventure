+.v4-quest-shell .v653-preparation-summary p { font-size:14px; line-height:1.55; margin:8px 0; }
+.v4-quest-shell .v653-preparation-summary .v653-preparation-focus { font-size:18px; line-height:1.45; color:var(--lesson-ink); font-weight:800; }
+.v653-preparation-summary dl { display:grid; gap:10px; margin:12px 0 0; }
+.v653-preparation-summary dl>div { display:grid; grid-template-columns:82px minmax(0,1fr); gap:8px; align-items:start; }
+.v653-preparation-summary dt { font-size:13px; font-weight:800; color:var(--lesson-muted,#526780); line-height:1.6; }
+.v653-preparation-summary dd { margin:0; font-size:14px; line-height:1.6; overflow-wrap:anywhere; }
+.v653-word-chip { display:inline-block; margin:0 5px 5px 0; padding:3px 8px; border-radius:8px; background:var(--lesson-soft); color:var(--lesson-ink); font-weight:700; }
+.v4-quest-shell .v653-preparation-summary .v64-preparation-materials { grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }
+.v4-quest-shell .v653-preparation-summary .v64-preparation-materials button { height:100%; min-height:68px; padding:10px; background:var(--lesson-soft); border-color:var(--lesson-line); }
